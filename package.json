{
  "name": "base-tecnica-grupo6",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": "22.22.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings",
    "codegen": "cd apps/api && go run ./cmd/api openapi > ../../contracts/openapi.yaml",
    "test:api": "cd apps/api && go test ./...",
    "test:e2e:api": "sh apps/api/e2e/correr.sh",
    "verify": "pnpm format:check && pnpm test:api"
  },
  "devDependencies": {
    "lefthook": "2.1.10",
    "oxlint": "1.75.0",
    "prettier": "3.9.6"
  }
}
